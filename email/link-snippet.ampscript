%%[
/* Lien de l'email vers la CloudPage de génération du lead.
   - CleOpaque : colonne de la DE d'envoi (GUID généré à l'import, voir sql/)
   - 12345     : ID de la CloudPage "lead-redirect" (à remplacer)
   CloudPagesURL chiffre le paramètre (?qs=...) : la clé n'est ni lisible
   ni modifiable dans l'URL.
   - t : heure d'envoi du job (GetSendTime), utilisée par la CloudPage pour
     ignorer les POST faits moins de quelques secondes après l'envoi (bots).
     Format yyyy-MM-dd HH:mm:ss, identique à celui calculé dans la CloudPage. */
VAR @cle, @lien, @st, @sendTs
SET @cle = AttributeValue("CleOpaque")
SET @st  = GetSendTime()
IF NOT EMPTY(@st) THEN
  SET @sendTs = FormatDate(@st, "yyyy-MM-dd HH:mm:ss", "", "fr-BE")
ELSE
  SET @sendTs = ""  /* prévisualisation : pas de contrôle de délai */
ENDIF
SET @lien = CloudPagesURL(12345, "k", @cle, "t", @sendTs)
]%%

<!-- RedirectTo() est obligatoire pour que le clic soit tracké -->
<a href="%%=RedirectTo(@lien)=%%" alias="CTA_Programme_Migration">Accéder à mon offre</a>
